def build(bld):
	source = [
		'bitmap.cpp',
		'ImageByteSwap.cpp',
		'colorconversion.cpp',
		'floatbitmap.cpp',
		'floatbitmap2.cpp',
		'floatbitmap3.cpp',
		'floatbitmap_bilateralfilter.cpp',
		'floatcubemap.cpp',
		'imageformat.cpp',
		'psd.cpp',
		'psheet.cpp',
		'resample.cpp',
		'tgaloader.cpp',
		'texturepacker.cpp',
		'tgawriter.cpp',
	]
	
	if bld.env.DEST_OS == 'win32':
		source += [
			'floatbitmap4.cpp'
		]

	includes = [
		'.',
		'../public',
		'../public/tier0',
		'../public/tier1',
		'../thirdparty/stb'
	]

	defines = []

	libs = []
	
	if bld.env.DEST_OS == 'win32':
		libs += ['NVTC']

	bld.stlib(
		source   = source,
		target   = PROJECT_NAME,
		name     = PROJECT_NAME,
		features = 'c cxx',
		includes = includes,
		defines  = defines,
		use      = libs,
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx      = bld.get_taskgen_count()
	)

