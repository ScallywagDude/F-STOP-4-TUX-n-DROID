#! /usr/bin/env python
# encoding: utf-8
# Crypto++ 5.61, built from source for the POSIX targets. The partner VPC links a prebuilt libcryptopp_client.a on
# Linux and cryptlib.lib on Windows; there is no prebuilt library for Android, so every POSIX target uses this one.
# Windows keeps the prebuilt cryptlib.lib (lib/win64/2015/release).

import os

top = '.'
PROJECT_NAME = 'cryptopp'

# the library's own test and benchmark programs (GNUmakefile: TESTOBJS)
TEST_SOURCES = {'bench.cpp', 'bench2.cpp', 'test.cpp', 'validat1.cpp', 'validat2.cpp', 'validat3.cpp', 'adhoc.cpp',
                'datatest.cpp', 'regtest.cpp', 'fipsalgt.cpp', 'dlltest.cpp'}

def options(opt):
	return

def configure(conf):
	return

def build(bld):
	if bld.env.DEST_OS == 'win32':
		return

	here = bld.path.abspath()
	source = sorted(f for f in os.listdir(here) if f.endswith('.cpp') and f not in TEST_SOURCES)

	bld.stlib(
		source   = source,
		target   = PROJECT_NAME,
		name     = PROJECT_NAME,
		features = 'cxx',
		includes = ['.'],
		# the x86 inline assembly is GCC-3 era and has no ARM version; the C++ paths are used everywhere
		defines  = ['NDEBUG', 'CRYPTOPP_DISABLE_ASM'],
		export_includes = ['.'],
		install_path = None,
		idx      = bld.get_taskgen_count()
	)
